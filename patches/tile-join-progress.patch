+// Opt-in diagnostics for QTopo's long-running retained-data importer.
+// Counters describe consumed input tiles; overlapping sheet tiles remain separate.
+static unsigned long long qtopo_checked_files = 0;
+static unsigned long long qtopo_input_tiles = 0;
+static unsigned long long qtopo_output_tiles = 0;
+
+static void qtopo_report_progress(const char *stage, bool force = false) {
+	static bool enabled = getenv("QTOPO_TILE_JOIN_PROGRESS") != NULL;
+	if (!enabled) return;
+	using clock = std::chrono::steady_clock;
+	static clock::time_point last;
+	auto now = clock::now();
+	if (!force && last != clock::time_point() && now - last < std::chrono::seconds(5)) return;
+	last = now;
+	fprintf(stderr, "\nQTOPO_ASSEMBLY {\"stage\":\"%s\",\"checkedFiles\":%llu,\"inputTiles\":%llu,\"outputTiles\":%llu}\n",
+	        stage, qtopo_checked_files, qtopo_input_tiles, qtopo_output_tiles);
+	fflush(stderr);
+}
 
